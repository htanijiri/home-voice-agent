+void Application::ToggleMicMute() {
+    Schedule([this]() {
+        mic_muted_ = !mic_muted_;
+        {
+            Settings settings("app", true);
+            settings.SetBool("mic_muted", mic_muted_);
+        }
+        ESP_LOGI(TAG, "Mic muted: %d", mic_muted_);
+        if (mic_muted_ && protocol_ && protocol_->IsAudioChannelOpened()) {
+            protocol_->CloseAudioChannel();
+        }
+        if (GetDeviceState() == kDeviceStateIdle) {
+            audio_service_.EnableWakeWordDetection(!mic_muted_);
+            Board::GetInstance().GetDisplay()->SetStatus(mic_muted_ ? MIC_MUTED_STATUS : Lang::Strings::STANDBY);
+        }
+        audio_service_.PlaySound(Lang::Sounds::OGG_POPUP);
+        if (auto led = Board::GetInstance().GetLed()) {
+            led->OnStateChanged();
+        }
+    });
