# firmware/config.env の例。コピーして値を入れる（config.env は gitignore 済み）
# 端末が最初に問い合わせる OTA の URL（自作サーバー）。開発中は Mac mini の LAN 内アドレス
OTA_URL=http://192.168.0.10:8080/xiaozhi/ota/
# ESP-IDF の場所
IDF_PATH=$HOME/esp/esp-idf-v6.1
# ウェイクワードのモデル（wn10_ja_airisu＝アイリス。代わりの候補は wn9_histackchan_tts3）
WAKE_WORD=wn10_ja_airisu
# 書き込みに使うシリアルポート（ls /dev/cu.usbmodem* で確認）
PORT=/dev/cu.usbmodem21101
