# server/.env の例。コピーして値を入れる（.env は gitignore 済み）。値をチャットやリポジトリに貼らない。
# 手順は docs/SETUP_ACCOUNTS.md

# Anthropic（Claude）の API キー
ANTHROPIC_API_KEY=
# Google Cloud のプロジェクト ID
GOOGLE_CLOUD_PROJECT=
# Google Cloud のサービスアカウントの鍵（JSON）の場所
GOOGLE_APPLICATION_CREDENTIALS=./data/secrets/google-sa.json

# 確認画面（005）：Google ログイン
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# ログインを許可するメールアドレス（カンマ区切り）
WEB_ALLOWED_EMAILS=a@example.com,b@example.com
